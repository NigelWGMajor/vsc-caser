        "configurationDefaults": {
            "markdown.copyFiles.destination": {
                "**/*": "${documentDirName}/image/${fileName}"
            }
        },
        "keybindings": [
            {
                "command": "caser.toPasteNestedImage",
                "key": "ctrl+v",
                "mac": "cmd+v",
                "when": "editorTextFocus && editorLangId == markdown && !editorReadonly"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "caser.toNestImages",
                    "when": "resourceExtname == .md",
                    "group": "navigation@10"
                },
                {
                    "command": "caser.toRepairDocumentLinks",
                    "when": "resourceExtname =~ /\\.(markdown|md|mdown|mdx|mkd)$/i",
                    "group": "navigation@10"
                },
                {
                    "command": "caser.toUnreferencedDocuments",
                    "when": "resourceExtname =~ /\\.(markdown|md|mdown|mdx|mkd)$/i",
                    "group": "navigation@10"
                },
                {
                    "command": "caser.toNewDocumentLocation",
                    "when": "resourceExtname =~ /\\.(markdown|md|mdown|mdx|mkd)$/i",
                    "group": "navigation@10"
                },
                {
                    "command": "caser.toWhereUsedLocally",
                    "when": "resourceExtname =~ /\\.(avif|bmp|gif|heic|heif|ico|jpe?g|png|svg|tiff?|webp)$/i",
                    "group": "navigation@10"
                },
                {
                    "command": "caser.toUnusedImages",
                    "when": "resourceExtname =~ /\\.(avif|bmp|gif|heic|heif|ico|jpe?g|png|svg|tiff?|webp)$/i",
                    "group": "navigation@10"
                }
            ]
        }
    },
    "scripts": {
        "xcompile": "npm run check-types && node esbuild.js",
        "check-types": "tsc --noEmit",
        "xwatch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "xwatch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "xvscode:prepublish": "npm run package",
        "xpackage": "npm run check-types && node esbuild.js --production",
        "compile": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "vscode:prepublish": "npm run package",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "pretest": "npm run compile && npm run compile-tests",
        "test": "vscode-test"
    },
